{
  "manifest_version": 1,
  "type": "device",
  "name": "LibreTranslate",
  "description": {
    "en": "Translate texts in your scenes with your own LibreTranslate server: local, free, no cloud.",
    "fr": "Traduisez des textes dans vos scènes avec votre serveur LibreTranslate : local, libre, sans cloud.",
    "de": "Übersetze Texte in deinen Szenen mit deinem LibreTranslate-Server: lokal, frei, ohne Cloud.",
    "es": "Traduzca textos en sus escenas con su servidor LibreTranslate: local, libre, sin nube."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-libretranslate:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-libretranslate/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Run LibreTranslate on your network (Docker: libretranslate/libretranslate, add --load-only en,fr,de,es to keep it small) and type its address below. The scene action \"LibreTranslate: translate a text\" then gives the translation to the next actions.",
        "fr": "Lancez LibreTranslate sur votre réseau (Docker : libretranslate/libretranslate, ajoutez --load-only en,fr,de,es pour l'alléger) et saisissez son adresse ci-dessous. L'action de scène « LibreTranslate : traduire un texte » donne alors la traduction aux actions suivantes.",
        "de": "Starte LibreTranslate in deinem Netzwerk (Docker: libretranslate/libretranslate, mit --load-only en,fr,de,es bleibt es klein) und gib unten seine Adresse ein. Die Szenenaktion „LibreTranslate: Text übersetzen“ gibt die Übersetzung dann an die nächsten Aktionen weiter.",
        "es": "Inicie LibreTranslate en su red (Docker: libretranslate/libretranslate, añada --load-only en,fr,de,es para aligerarlo) e introduzca su dirección abajo. La acción de escena «LibreTranslate: traducir un texto» pasa entonces la traducción a las acciones siguientes."
      },
      "links": [
        {
          "url": "https://docs.libretranslate.com/guides/installation/",
          "label": {
            "en": "Install LibreTranslate",
            "fr": "Installer LibreTranslate",
            "de": "LibreTranslate installieren",
            "es": "Instalar LibreTranslate"
          }
        },
        {
          "url": "https://github.com/guim31/gladys-libretranslate/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Server address",
        "fr": "Adresse du serveur",
        "de": "Serveradresse",
        "es": "Dirección del servidor"
      },
      "description": {
        "en": "IP or name of the server, port 5000 by default, or the full address behind a reverse proxy.",
        "fr": "IP ou nom du serveur, port 5000 par défaut, ou l'adresse complète derrière un proxy inverse.",
        "de": "IP oder Name des Servers, standardmäßig Port 5000, oder die volle Adresse hinter einem Reverse-Proxy.",
        "es": "IP o nombre del servidor, puerto 5000 por defecto, o la dirección completa tras un proxy inverso."
      },
      "placeholder": {
        "en": "http://192.168.1.20:5000",
        "fr": "http://192.168.1.20:5000",
        "de": "http://192.168.1.20:5000",
        "es": "http://192.168.1.20:5000"
      },
      "required": true
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key (optional)",
        "fr": "Clé d'API (facultative)",
        "de": "API-Schlüssel (optional)",
        "es": "Clave de API (opcional)"
      },
      "description": {
        "en": "Only when the server requires one (started with --api-keys, or a public instance). Never logged.",
        "fr": "Seulement si le serveur en exige une (lancé avec --api-keys, ou une instance publique). Jamais journalisée.",
        "de": "Nur wenn der Server einen verlangt (mit --api-keys gestartet, oder eine öffentliche Instanz). Nie protokolliert.",
        "es": "Solo si el servidor la exige (iniciado con --api-keys, o una instancia pública). Nunca se registra."
      },
      "required": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Names of the device features, and of the language given by \"detect the language\".",
        "fr": "Noms des fonctionnalités de l'appareil, et de la langue donnée par « détecter la langue ».",
        "de": "Namen der Gerätefunktionen und der Sprache, die „Sprache erkennen“ liefert.",
        "es": "Nombres de las funciones del dispositivo y del idioma que da «detectar el idioma»."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 60,
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads the version and the languages of the server, then translates one word to check the key.",
        "fr": "Lit la version et les langues du serveur, puis traduit un mot pour vérifier la clé.",
        "de": "Liest Version und Sprachen des Servers und übersetzt dann ein Wort, um den Schlüssel zu prüfen.",
        "es": "Lee la versión y los idiomas del servidor y luego traduce una palabra para comprobar la clave."
      }
    }
  ],
  "widgets": [
    {
      "key": "libretranslate",
      "icon": "globe",
      "label": {
        "en": "LibreTranslate",
        "fr": "LibreTranslate",
        "de": "LibreTranslate",
        "es": "LibreTranslate"
      },
      "description": {
        "en": "The translation server, its languages, the translations of your scenes today.",
        "fr": "Le serveur de traduction, ses langues, les traductions de vos scènes du jour.",
        "de": "Der Übersetzungsserver, seine Sprachen, die heutigen Übersetzungen deiner Szenen.",
        "es": "El servidor de traducción, sus idiomas, las traducciones de sus escenas de hoy."
      },
      "settings": [
        {
          "key": "show_languages",
          "type": "boolean",
          "label": {
            "en": "Show the list of languages",
            "fr": "Afficher la liste des langues",
            "de": "Liste der Sprachen zeigen",
            "es": "Mostrar la lista de idiomas"
          },
          "required": false,
          "default": true
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "translate",
      "timeout_seconds": 60,
      "label": {
        "en": "LibreTranslate: translate a text",
        "fr": "LibreTranslate : traduire un texte",
        "de": "LibreTranslate: Text übersetzen",
        "es": "LibreTranslate: traducir un texto"
      },
      "description": {
        "en": "Translates the text (variables allowed) on your server and gives the translation to the next actions, e.g. a message or a spoken text.",
        "fr": "Traduit le texte (variables possibles) sur votre serveur et donne la traduction aux actions suivantes, par exemple un message ou un texte lu.",
        "de": "Übersetzt den Text (Variablen möglich) auf deinem Server und gibt die Übersetzung an die nächsten Aktionen, z. B. eine Nachricht oder eine Sprachausgabe.",
        "es": "Traduce el texto (se admiten variables) en su servidor y pasa la traducción a las acciones siguientes, por ejemplo un mensaje o un texto hablado."
      },
      "fields": [
        {
          "key": "text",
          "type": "string",
          "required": true,
